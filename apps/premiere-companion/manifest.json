{
  "manifestVersion": 5,
  "id": "com.dubcodes.kairix-pimp.premiere-companion",
  "name": "Kairix PIMP — Premiere Companion",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "kairix-pimp-premiere-companion",
      "label": {
        "default": "Kairix PIMP"
      },
      "minimumSize": { "width": 300, "height": 360 },
      "preferredDockedSize": { "width": 360, "height": 560 },
      "preferredFloatingSize": { "width": 420, "height": 620 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
