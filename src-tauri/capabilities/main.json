{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Minimal shell permissions; filesystem work is exposed only through validated application commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-progress-bar",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart"
  ]
}
